# YaCy Janitor Stack Configuration
# Copy this file to .env and fill in your values

# YaCy Admin Password
YACY_ADMIN_PASSWORD=yacy

# LLM Configuration
# Provider: openai, anthropic, or local
LLM_PROVIDER=openai

# OpenAI API Key (required for LLM classification)
LLM_API_KEY=sk-your-api-key-here

# LLM Model (default: gpt-4o-mini for cost efficiency)
LLM_MODEL=gpt-4o-mini

# For local/custom LLM endpoints (e.g., Ollama, vLLM)
# LLM_BASE_URL=http://localhost:11434/v1

# Public URL for the seed collector (for bookmarklet generation)
PUBLIC_URL=http://localhost:8091

# Scheduling intervals (in minutes)
HOST_SCAN_INTERVAL=60
CLASSIFICATION_INTERVAL=15
SEED_INTAKE_INTERVAL=5

# Classification thresholds (0.0 - 1.0)
KEEP_THRESHOLD=0.7
BAN_THRESHOLD=0.8
